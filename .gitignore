# ==========================================
# Sécurité & Variables d'environnement
# ==========================================
.env
.env.*
!.env.example
*.env
**/.env
**/.env.*
!**/.env.example

# Clés, secrets & certificats
*.key
*.pem
*.crt
*.pfx
auth.json
oauth-private.key
oauth-public.key

# ==========================================
# Bases de données locales
# ==========================================
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.db

# ==========================================
# Dépendances & Paquets
# ==========================================
node_modules/
**/node_modules/
vendor/
**/vendor/

# ==========================================
# Builds & Compilation
# ==========================================
dist/
**/dist/
out-tsc/
**/out-tsc/
public/build/
public/hot/
public/storage

# ==========================================
# Logs & Caches
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.phpunit.result.cache
.phpunit.cache/
.sass-cache/
.angular/cache/
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
!storage/**/.gitignore

# ==========================================
# Outils & IDEs
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
.DS_Store
Thumbs.db
